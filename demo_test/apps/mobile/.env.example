# EXPO_PUBLIC_* values are bundled into the client. Base URLs are public configuration.
# Never place database passwords, service-role/admin keys, access tokens, or other secrets here.
# Missing/blank USE_MOCK defaults to Mock. Set false only for the frontend Draft Contract,
# then restart Expo. Upload, retry, Statistics, CV, and Logs Real contracts remain unavailable.
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_API_BASE_URL=
# Public demo scenario only; never place secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_HOME_MOCK_SCENARIO=success
# Public upload demo scenario: success or fail-once.
EXPO_PUBLIC_UPLOAD_MOCK_SCENARIO=success
# Public video list demo scenario: success, empty, or error.
EXPO_PUBLIC_VIDEO_LIST_MOCK_SCENARIO=success
