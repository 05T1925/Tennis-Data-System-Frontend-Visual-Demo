# VITE_* values are bundled into the client. Base URLs are public configuration.
# Never place database passwords, service-role/admin keys, access tokens, or other secrets here.
# Missing/blank USE_MOCK defaults to Mock. Set false only for the frontend Draft Contract,
# then restart Vite. Upload, retry, Statistics, CV, and Logs Real contracts remain unavailable.
VITE_USE_MOCK=true
VITE_API_BASE_URL=
VITE_WEB_VIDEO_MOCK_SCENARIO=success
